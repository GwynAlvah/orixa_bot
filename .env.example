DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional: comma separated guild IDs to deploy slash commands to (defaults to DISCORD_GUILD_ID)
DISCORD_GUILD_IDS=
OPENSEA_API_KEY=
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
# Parallel balance reads during a holder sync. Lower this if your RPC rate limits you.
ARC_RPC_CONCURRENCY=4
# Attempts per RPC call before giving up. Rate limits and 5xx are retried with backoff.
ARC_RPC_MAX_ATTEMPTS=4
VERIFICATION_TTL_MINUTES=15
HOLDER_ROLE_SYNC_INTERVAL_MINUTES=30
